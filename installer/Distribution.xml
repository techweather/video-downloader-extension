<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>dlwithit</title>
    <organization>com.dlwithit</organization>
    <domains enable_localSystem="true"/>

    <welcome    file="welcome.html"    mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <options customize="always" require-scripts="false" rootVolumeOnly="true" hostArchitectures="x86_64,arm64"/>

    <choices-outline>
        <line choice="app"/>
        <line choice="firefox"/>
        <line choice="chrome"/>
    </choices-outline>

    <choice id="app"
            title="dlwithit app"
            description="The dlwithit Mac app — required."
            start_selected="true"
            start_enabled="false"
            visible="true">
        <pkg-ref id="com.dlwithit.app"/>
    </choice>

    <choice id="firefox"
            title="Firefox extension"
            description="Sets up the dlwithit Firefox extension. Firefox will open after install with a single confirmation prompt."
            start_selected="true"
            visible="true">
        <pkg-ref id="com.dlwithit.firefox"/>
    </choice>

    <choice id="chrome"
            title="Chrome extension"
            description="Sets up the dlwithit Chrome extension. Chrome will open to the Chrome Web Store listing — click 'Add to Chrome' to install."
            start_selected="true"
            visible="true">
        <pkg-ref id="com.dlwithit.chrome"/>
    </choice>

    <pkg-ref id="com.dlwithit.app"     version="1.0.0">dlwithit-app.pkg</pkg-ref>
    <pkg-ref id="com.dlwithit.firefox" version="1.0.0">dlwithit-firefox.pkg</pkg-ref>
    <pkg-ref id="com.dlwithit.chrome"  version="1.0.0">dlwithit-chrome.pkg</pkg-ref>
</installer-gui-script>
